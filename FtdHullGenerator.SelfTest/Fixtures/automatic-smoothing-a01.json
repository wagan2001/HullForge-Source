      "authoritative": false,
      "gateRole": "advisory",
      "definition": "Distance from each sampled intended exterior hull point to the nearest export-effective candidate exterior face; interior armor and the open-deck aperture are excluded. No score is recorded in A01 because the analytic target sampler is not yet exposed to the evidence surface."
    },
    {
      "id": "appearance.uncovered-intended-surface",
      "unit": "m^2",
      "perCaseAggregation": "sum of fixed target-surface tessellation area lacking an export-effective candidate face within 0.125 m normal distance",
      "suiteAggregation": "development and holdout reported separately as total uncovered m^2 and area-weighted uncovered fraction",
      "authoritative": false,
      "gateRole": "advisory",
      "definition": "Intended exterior target area not covered by the candidate; required openings and deliberately un-decked regions are excluded by the same mask for every method. A01 records the definition before A02 implements the sampler."
    },
    {
      "id": "appearance.patch-boundary-discontinuity",
      "unit": "m",
      "perCaseAggregation": "maximum and p95 absolute face-edge separation across every declared patch boundary, with method transitions counted and hull ends excluded",
      "suiteAggregation": "development and holdout reported separately as maximum case maximum and median case p95",
      "authoritative": false,
      "gateRole": "advisory",
      "definition": "Export-effective physical face separation at a smoothing-patch seam. Occupied-cell adjacency alone is insufficient; A01 leaves values unscored until A02 supplies explicit patch provenance and boundary signatures."
    },
    {
      "id": "appearance.unnecessary-fragmentation",
      "unit": "native smoothing placements per 100 m^2",
      "perCaseAggregation": "native smoothing placement count divided by baseline exterior hull-skin area and multiplied by 100; also report raw count and orientation-switch count",
      "suiteAggregation": "development and holdout reported separately as median density, maximum density, and total raw placements",
      "authoritative": false,
      "gateRole": "advisory",
      "definition": "Counts native smoothing placements without decomposing slope length or handed families. Straight shell beams are normalized to occupied one-metre cells only for base equality, never for this metric."
    }
  ],
