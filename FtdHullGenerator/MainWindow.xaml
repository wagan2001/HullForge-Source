<Window x:Class="FtdHullGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FtdHullGenerator.UI"
        xmlns:workspace="clr-namespace:FtdHullGenerator.UI.Workspace"
        Title="Hull Forge — FTD Blueprint Generator" Height="860" Width="1420" MinHeight="680" MinWidth="1100"
        Icon="Assets/HullForge.ico"
        Background="{DynamicResource ChassisBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{StaticResource PanelFont}"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        PreviewKeyDown="WindowPreviewKeyDown">
    <Grid Background="{DynamicResource ChassisBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Background="{DynamicResource PanelHeaderBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="CatalogStatusLamp" Width="9" Height="9" Margin="0,0,9,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="CatalogStatusText"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Checking game installation" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- One bitmap carries the brand: the same art is used for the title bar,
                         window icon, and taskbar icon. -->
                    <Border Width="48" Height="34" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Image Source="Assets/HullForgeLogo.png" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}" Text="Hull Forge" />
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="UndoButton" Style="{StaticResource CompactButtonStyle}" Content="Undo"
                                Click="UndoClicked" ToolTip="Undo one committed edit (Ctrl+Z)." />
                        <Button x:Name="RedoButton" Style="{StaticResource CompactButtonStyle}" Content="Redo"
                                Margin="4,0,0,0" Click="RedoClicked" ToolTip="Redo one committed edit (Ctrl+Y)." />
                    </StackPanel>
                    <TextBlock x:Name="ProjectNameText" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" Text="Untitled ship"
                               ToolTip="The name this session's hull will export under." />
                    <ToggleButton x:Name="ExperimentalFeaturesToggle" Style="{StaticResource CompactToggleStyle}"
                                  Content="EXPERIMENTAL" Margin="14,0,0,0" VerticalAlignment="Center"
                                  Checked="ExperimentalFeaturesChanged" Unchecked="ExperimentalFeaturesChanged"
                                  ToolTip="Expose unfinished V2 features that still require validation." />
                    <Button x:Name="ThemeButton" Style="{StaticResource CompactButtonStyle}"
                            Content="LIGHT MODE" Margin="8,0,0,0" VerticalAlignment="Center"
                            Click="ThemeClicked"
                            ToolTip="Switch to the light workbench. Either palette is a standard Hull Forge choice." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Working area -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="320" MaxWidth="520" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" ToolTip="Resize parameters and preview" />

            <!-- Configuration column. The panes scroll; the export key is pinned beneath
                 them so it stays reachable whatever is open or scrolled out of sight. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Padding="0,0,4,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SidebarSettingsPanel">

                        <!-- Hull Presets. The primary starting surface is a modeless presets
                             window, opened on launch and by this button, instead of an inline
                             drop-down pane. -->
                        <Button x:Name="HullPresetsButton" Margin="0,0,0,10"
                                Click="OpenHullPresetsClicked" Content="Hull Presets" />

                        <!-- Dimensions -->
                        <Expander Header="Hull dimensions" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="0,4,0,0">
                                <ui:DimensionInput x:Name="LengthInput" Label="Length" Unit="m" SliderMinimum="3" SliderMaximum="200" Value="100" ValueChanged="DimensionChanged"
                                                   ToolTip="Whole metres, from 3 to 200 m." />
                                <ui:DimensionInput x:Name="WidthInput" Label="Width" Unit="m" SliderMinimum="1" SliderMaximum="99" Value="21" Step="2" ValueChanged="DimensionChanged"
                                                   ToolTip="Odd metres, up to 99 m, so the hull has a single-block centreline. Even widths can be enabled under Advanced / Debug." />
                                <ui:DimensionInput x:Name="HeightInput" Label="Midship height" Unit="m" SliderMinimum="2" SliderMaximum="50" Value="12" ValueChanged="DimensionChanged"
                                                   ToolTip="Hull height at midships. The finished hull, including rise and bulb, must fit within 50 m." />
                                <Border Style="{StaticResource RecessStyle}" Padding="10,6" Margin="0,0,0,2">
                                    <DockPanel>
                                        <TextBlock x:Name="OverallHeightText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" Text="12 m" />
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" Text="Overall height" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Bow -->
                        <Expander Header="Bow" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,0" Text="Style" />
                                <ComboBox x:Name="BowStyleBox" SelectionChanged="ShapeStyleChanged" />
                                <ui:SliderRow x:Name="BowFullnessSlider" Label="Fullness" Minimum="-1.5" Maximum="1.5" Value="0" ValueChanged="ShapeSettingChanged"
                                              ToolTip="−1.5 fine and narrow · +1.5 full and broad" />
                                <ui:SliderRow x:Name="BowFlareSlider" Label="Flare" Minimum="-1.5" Maximum="1.5" Value="0.15" ValueChanged="ShapeSettingChanged"
                                              ToolTip="−1.5 inward · +1.5 strongly flared" />
                                <ui:DimensionInput x:Name="EntranceLengthInput" Label="Entrance" Unit="%" SliderMinimum="5" SliderMaximum="80" Value="45" ValueChanged="ShapeSettingChanged"
                                                   ToolTip="How much of the hull length the bow transition influences." />
                                <CheckBox x:Name="BulbCheckBox" Margin="0,2,0,8" IsChecked="False" Content="Bulbous bow"
                                          ToolTip="Adds a rounded bulb at the stem of any bow style."
                                          Checked="BulbToggled" Unchecked="BulbToggled" />
                                <!-- Bulb panel. The bulb's proportions only matter while it is switched
                                     on, so the panel stows away otherwise and keeps its values. -->
                                <Border x:Name="BulbPanel" Style="{StaticResource RecessStyle}" Padding="10,8,10,2" Margin="0,0,0,10" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,0,0,8" Text="Bulb · percent of hull" />
                                        <ui:DimensionInput x:Name="BulbLengthInput" Label="Length" Unit="%" SliderMinimum="2" SliderMaximum="30" Value="8" ValueChanged="BulbSettingChanged"
                                                           ToolTip="Percent of hull length." />
                                        <ui:DimensionInput x:Name="BulbWidthInput" Label="Width" Unit="%" SliderMinimum="10" SliderMaximum="70" Value="35" ValueChanged="BulbSettingChanged"
                                                           ToolTip="Percent of beam." />
                                        <ui:DimensionInput x:Name="BulbForeAftInput" Label="Fore/aft" Unit="%" SliderMinimum="-40" SliderMaximum="40" Value="0" ValueChanged="BulbSettingChanged"
                                                           ToolTip="Bulb centre ahead of the stem, as a percent of hull length. Negative tucks it into the forefoot." />
                                        <ui:DimensionInput x:Name="BulbRiseInput" Label="Rise" Unit="%" SliderMinimum="-50" SliderMaximum="50" Value="0" ValueChanged="BulbSettingChanged"
                                                           ToolTip="Bulb underside relative to the keel, as a percent of midship height. Negative values lower it below the keel." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Body -->
                        <Expander Header="Body" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,0" Text="Form preset" />
                                <ComboBox x:Name="BodyStyleBox" SelectionChanged="BodyStyleChanged"
                                          ToolTip="Loads a starting body form. Every slider below stays editable, and editing any of them switches the preset to Custom." />
                                <ui:SliderRow x:Name="BodyFullnessSlider" Label="Fullness" Minimum="-1.5" Maximum="1.5" Value="0.35" ValueChanged="BodyShapeSliderChanged"
                                              ToolTip="−1.5 deep V · +1.5 full and flat" />
                                <ui:SliderRow x:Name="BodySideShapeSlider" Label="Side shape" Minimum="-1.5" Maximum="1.5" Value="0.1" ValueChanged="BodyShapeSliderChanged"
                                              ToolTip="−1.5 tumblehome · +1.5 flare" />
                                <ui:SliderRow x:Name="BodyChineSlider" Label="Chine" Minimum="-1.5" Maximum="1.5" Value="-0.65" ValueChanged="BodyShapeSliderChanged"
                                              ToolTip="−1.5 soft and rounded · +1.5 hard chine" />
                                <ui:SliderRow x:Name="BodyFlatBottomSlider" Label="Flat bottom" Minimum="0" Maximum="1" Value="0" ValueChanged="BodyShapeSliderChanged"
                                              ToolTip="0 tapered keel · 1 full-beam horizontal floor with vertical sides" />
                            </StackPanel>
                        </Expander>

                        <!-- Stern -->
                        <Expander Header="Stern" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,0" Text="Style" />
                                <ComboBox x:Name="SternStyleBox" SelectionChanged="ShapeStyleChanged" />
                                <ui:SliderRow x:Name="SternFullnessSlider" Label="Fullness" Minimum="-1.5" Maximum="1.5" Value="0" ValueChanged="ShapeSettingChanged"
                                              ToolTip="−1.5 fine and narrow · +1.5 full and broad" />
                                <ui:SliderRow x:Name="SternSideShapeSlider" Label="Side shape" Minimum="-1.5" Maximum="1.5" Value="0" ValueChanged="ShapeSettingChanged"
                                              ToolTip="−1.5 tumblehome · +1.5 flare" />
                                <ui:DimensionInput x:Name="RunLengthInput" Label="Run" Unit="%" SliderMinimum="5" SliderMaximum="80" Value="25" ValueChanged="ShapeSettingChanged"
                                                   ToolTip="How much of the hull length the stern transition influences." />
                            </StackPanel>
                        </Expander>

                        <!-- Profile -->
                        <Expander Header="Profile" Margin="0,0,0,10">
                            <StackPanel>
                                <ui:DimensionInput x:Name="BowDeckRiseInput" Label="Bow deck rise" Unit="m" SliderMinimum="0" SliderMaximum="10" Value="0" ValueChanged="ProfileSettingChanged"
                                                   ToolTip="Raises the bow deck above the midship deck and adds to overall height." />
                                <ui:DimensionInput x:Name="SternDeckRiseInput" Label="Stern deck rise" Unit="m" SliderMinimum="0" SliderMaximum="10" Value="0" ValueChanged="ProfileSettingChanged"
                                                   ToolTip="Raises the stern deck above the midship deck and adds to overall height." />
                                <ui:DimensionInput x:Name="BowKeelRiseInput" Label="Bow keel rise" Unit="m" SliderMinimum="0" SliderMaximum="10" Value="0" ValueChanged="ProfileSettingChanged"
                                                   ToolTip="Lifts the forefoot while the midship keel remains level." />
                                <ui:DimensionInput x:Name="SternKeelRiseInput" Label="Stern keel rise" Unit="m" SliderMinimum="0" SliderMaximum="10" Value="0" ValueChanged="ProfileSettingChanged"
                                                   ToolTip="Lifts the stern run while the midship keel remains level." />
                            </StackPanel>
                        </Expander>

                        <!-- Construction -->
                        <Expander Header="Construction" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,0" Text="Side armor · outside to inside"
                                           ToolTip="One metre per layer, working inward from the hull surface. Choose solid beams, poles, or a beam-slope pattern per layer." />
                                <StackPanel x:Name="HullArmorLayersPanel" Margin="0,6,0,0" />
                                <Button Margin="0,6,0,12" HorizontalAlignment="Left" Click="AddHullArmorLayerClicked" Content="Add Side Layer" />

                                <Border Style="{StaticResource RuleStyle}" Margin="0,0,0,8" />

                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Bottom armor · outside to inside"
                                           ToolTip="One metre per layer, working inward from the underside. Sides own equal-depth intersections." />
                                <StackPanel x:Name="BottomArmorLayersPanel" Margin="0,6,0,0" />
                                <Button Margin="0,6,0,12" HorizontalAlignment="Left" Click="AddBottomArmorLayerClicked" Content="Add Bottom Layer" />
                                <CheckBox x:Name="DeckCheckBox" IsChecked="True" Content="Add deck" Checked="DeckSettingsChanged" Unchecked="DeckSettingsChanged"
                                          ToolTip="Layers the deck from the top downward. Hull armor owns the shared rim cells." />
                                <StackPanel x:Name="DeckArmorEditor">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Deck armor · top to bottom" />
                                    <StackPanel x:Name="DeckArmorLayersPanel" Margin="0,6,0,0" />
                                    <Button x:Name="AddDeckLayerButton" Margin="0,6,0,0" HorizontalAlignment="Left" Click="AddDeckArmorLayerClicked" Content="Add Deck Layer" />
                                </StackPanel>

                                <Border Style="{StaticResource RuleStyle}" Margin="0,12,0,0" />

                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Hull smoothing" />
                                <ComboBox x:Name="SmoothingBox" SelectionChanged="SmoothingChanged">
                                    <ComboBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.Panel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </GroupStyle.Panel>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" Margin="9,8,9,4"
                                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ComboBox.GroupStyle>
                                </ComboBox>
                                <StackPanel x:Name="HybridOffsetPanel" Margin="0,4,0,0" Visibility="Collapsed">
                                    <ui:DimensionInput x:Name="HybridOffsetInput"
                                                       Label="Horizontal top offset"
                                                       Unit="m"
                                                       SliderMinimum="1"
                                                       SliderMaximum="11"
                                                       Value="1"
                                                       ValueChanged="SettingsChanged"
                                                       ToolTip="Vertical fill below this height; horizontal fill above it." />
                                </StackPanel>

                            </StackPanel>
                        </Expander>

                        <!-- Advanced / Debug is a peer of Construction, not a nested construction option. -->
                        <Expander Margin="0,0,0,10" Header="Advanced / Debug">
                            <StackPanel>
                                <CheckBox x:Name="SingleBlocksCheckBox" Margin="0,4,0,0" IsChecked="False" Content="Keep 1 m blocks" Checked="SettingsChanged" Unchecked="SettingsChanged"
                                          ToolTip="Skip merging fore-and-aft runs into 2/3/4 m beams and 1/2/3/4 m poles." />
                                <CheckBox x:Name="ShowInternalArmorCheckBox" Margin="0,8,0,0" IsChecked="False" IsEnabled="False" Content="Render internal armor on large hulls" Checked="ShowInternalArmorChanged" Unchecked="ShowInternalArmorChanged" />
                                <CheckBox x:Name="AllowEvenWidthCheckBox" Margin="0,8,0,0" IsChecked="False" Content="Allow even widths"
                                          Checked="AllowEvenWidthChanged" Unchecked="AllowEvenWidthChanged"
                                          ToolTip="Lets width count in single metres. Even hulls centre between two block columns and require confirmation before export." />
                                <CheckBox x:Name="RecordGenerationParametersCheckBox" Margin="0,8,0,0" IsChecked="False" Content="Save generation parameters"
                                          ToolTip="Debug export option. Writes a readable .generation.json sidecar beside the blueprint with the exact values used to generate this hull, including effective fallback values." />
                            </StackPanel>
                        </Expander>

                        <!-- Output -->
                        <Expander Header="Output">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,0" Text="Blueprint name" />
                                <CheckBox x:Name="CustomNameCheckBox" Margin="0,6,0,4" IsChecked="False" Content="Name this hull myself"
                                          Checked="CustomNameToggled" Unchecked="CustomNameToggled"
                                          ToolTip="Replaces the generated HF_ name with your own. Clearing this restores the generated name." />
                                <TextBox x:Name="BlueprintNameBox" IsReadOnly="True" TextWrapping="Wrap" Text="HF_Dolphin_100x21x12"
                                         MaxLength="96" TextChanged="CustomNameEdited"
                                         ToolTip="The exact file name the export will use, without its extension." />
                                <TextBlock x:Name="NameNoticeText" Style="{StaticResource MetricLabelStyle}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Visibility="Collapsed"
                                           Foreground="{DynamicResource WarningBrush}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,2,0,0" Text="Destination" />
                                <TextBox x:Name="DestinationBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="44" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button Click="BrowseDestinationClicked" Content="Choose folder" />
                                    <Button Margin="8,0,0,0" Click="OpenDestinationClicked" Content="Open folder" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,0" Text="Game installation" />
                                <TextBox x:Name="GameDirectoryBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="44" />
                                <Button HorizontalAlignment="Left" Click="BrowseGameClicked" Content="Choose game folder" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="SidebarActionsPanel" Grid.Row="1" Margin="0,10,4,0">
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button x:Name="RandomizeButton" Margin="0,0,4,0" Click="RandomizeClicked" Content="Randomize"
                                ToolTip="Generate a random hull shape using the current dimensions and armor." />
                        <Button Margin="4,0,0,0" Click="ResetEditorClicked" Content="Reset"
                                ToolTip="Reset hull dimensions, shape, armor, smoothing, and view to the defaults." />
                    </UniformGrid>
                    <Button x:Name="ExportButton" Style="{StaticResource PrimaryButtonStyle}"
                            Click="ExportClicked" Content="Export blueprint" />
                </StackPanel>
            </Grid>

            <!-- The viewport keeps a hard minimum while the task workspace is resized below it. -->
            <Grid x:Name="PreviewWorkspaceGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ViewportRow" Height="*" MinHeight="280" />
                    <RowDefinition x:Name="WorkspaceSplitterRow" Height="8" />
                    <RowDefinition x:Name="WorkspaceRow" Height="240" MinHeight="150" />
                </Grid.RowDefinitions>

            <!-- Lattice view -->
            <Border Grid.Row="0" Style="{StaticResource PanelBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource GroupHeaderStyle}" Padding="12,6" CornerRadius="3,3,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"
                                           Margin="0,0,10,0" Text="View" />
                                <Button Style="{StaticResource CompactButtonStyle}" Content="ISO"
                                        ToolTip="Above the bow" Click="IsometricViewClicked" />
                                <Button Style="{StaticResource CompactButtonStyle}" Margin="4,0,0,0" Content="Side"
                                        ToolTip="Square on to the side" Click="SideViewClicked" />
                                <Button Style="{StaticResource CompactButtonStyle}" Margin="4,0,0,0" Content="Top"
                                        ToolTip="Looking down, bow up the screen" Click="TopViewClicked" />
                                <Button Style="{StaticResource CompactButtonStyle}" Margin="4,0,0,0" Content="Bow"
                                        ToolTip="Square on to the bow" Click="BowViewClicked" />
                                <Border Width="1" Margin="10,4" Background="{DynamicResource PanelBorderBrush}" />
                                <ToggleButton x:Name="AutoRotateToggle" Style="{StaticResource CompactToggleStyle}"
                                              IsChecked="False" Checked="AutoRotateChanged" Unchecked="AutoRotateChanged"
                                              Content="Auto-turn"
                                              ToolTip="Turns the gentle preview rotation on or off. Off by default; choosing a standing view pauses the turn, and grabbing the hull and letting go brings it back." />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Hull preview" />
                                <TextBlock Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"
                                           Margin="0,2,0,0" Text="Drag to orbit · Scroll to zoom" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Cutaway strip. Sections the drawn hull on one plane so the armor
                         layers behind the shell can be inspected from a standing view. -->
                    <Border Grid.Row="1" Background="{DynamicResource PanelHeaderBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="12,5">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"
                                       Margin="0,0,10,0" Text="Cutaway" />
                            <ComboBox x:Name="CutawayBox" DockPanel.Dock="Left" Width="170" Margin="0"
                                      VerticalAlignment="Center" SelectionChanged="CutawayPlaneChanged"
                                      ToolTip="Sections the drawn hull on one plane. Display only." />
                            <TextBlock x:Name="CutawayReadout" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Margin="12,0,0,0" MinWidth="118" TextAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Text="——" />
                            <Slider x:Name="CutawaySlider" Margin="14,0,0,0" VerticalAlignment="Center"
                                    Minimum="0" Maximum="100" Value="50" IsEnabled="False"
                                    SmallChange="1" LargeChange="10"
                                    ValueChanged="CutawayPositionChanged" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource ViewportBackgroundBrush}">
                        <Grid ClipToBounds="True" Background="Transparent"
                              MouseLeftButtonDown="PreviewEmptyAreaPointerDown">
                            <Rectangle Fill="{DynamicResource MinorGridBrush}" IsHitTestVisible="False" />
                            <Rectangle Fill="{DynamicResource MajorGridBrush}" IsHitTestVisible="False" />
                            <ui:HullPreviewControl x:Name="Preview" />
                        </Grid>
                    </Border>

                    <!-- Quiet divider between the drawing and measurements. -->
                    <Border Grid.Row="3" Height="1" Background="{DynamicResource PanelBorderBrush}" />

                    <!-- Readout strip -->
                    <Border Grid.Row="4" Background="{DynamicResource PanelHeaderBrush}" Padding="12,10" CornerRadius="0,0,3,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource TileStyle}" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileLabelStyle}" Text="Placed blocks" />
                                    <TextBlock x:Name="BlockCountText" Margin="0,3,0,0" Style="{StaticResource ReadoutValueStyle}" Text="——" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource TileStyle}" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileLabelStyle}" Text="Outer size" />
                                    <TextBlock x:Name="DimensionsText" Margin="0,3,0,0" Style="{StaticResource ReadoutValueStyle}" Text="——" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource TileStyle}" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileLabelStyle}" Text="Est. material" />
                                    <TextBlock x:Name="MaterialCostText" Margin="0,3,0,0" Style="{StaticResource ReadoutValueStyle}" Text="——" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

                <GridSplitter x:Name="WorkspaceSplitter" Grid.Row="1" Height="8"
                              HorizontalAlignment="Stretch" Background="Transparent"
                              ShowsPreview="True" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              DragCompleted="WorkspaceSplitterDragCompleted"
                              ToolTip="Resize preview and workspace" />
                <workspace:WorkspaceHost x:Name="DockedWorkspaceHost" Grid.Row="2"
                                         ToggleHostRequested="WorkspaceHostToggleRequested" />
            </Grid>
        </Grid>

        <!-- Status line -->
        <Border Grid.Row="2" Padding="18,8" Background="{DynamicResource PanelHeaderBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Ellipse x:Name="StatusLamp" DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,10,0"
                         VerticalAlignment="Center" Fill="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource StatusLineStyle}" VerticalAlignment="Center"
                           Text="Ready." TextWrapping="Wrap" />
            </DockPanel>
        </Border>

    </Grid>
</Window>
