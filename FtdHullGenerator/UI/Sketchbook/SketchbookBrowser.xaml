<UserControl x:Class="FtdHullGenerator.UI.Sketchbook.SketchbookBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="CardList"
                      HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="Hull presets">
            <ItemsControl.GroupStyle>
                <GroupStyle>
                    <GroupStyle.Panel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GroupStyle.Panel>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                       Margin="2,10,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource RecessStyle}" Width="300" Padding="10,8" Margin="0,0,8,8">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Top"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding Ordinal, StringFormat='#{0:00}'}" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding SuggestedSummary}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text=" suggested · " Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding MinimumSummary}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                <TextBlock Text=" minimum" Style="{StaticResource MetricLabelStyle}" />
                            </StackPanel>

                            <Border Style="{StaticResource RecessStyle}" Padding="6" Margin="0,6,0,0">
                                <StackPanel>
                                    <Image Source="{Binding Thumbnail}" Width="264" Height="176"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Style="{StaticResource MetricLabelStyle}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Text="{Binding ThumbnailError}"
                                               Visibility="{Binding HasThumbnailError, Converter={StaticResource BoolToVisibility}}" />

                                    <StackPanel Visibility="{Binding ShowsSectionInset, Converter={StaticResource BoolToVisibility}}">
                                        <Border Style="{StaticResource RuleStyle}" Margin="0,6,0,6" />
                                        <Image Source="{Binding SectionInset}" Width="264" Height="176"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource CompactButtonStyle}"
                                        Content="Use suggested size"
                                        Click="UseSuggestedSizeClicked" />
                                <Button Style="{StaticResource CompactButtonStyle}" Margin="6,0,0,0"
                                        Content="Keep current size"
                                        Click="KeepCurrentSizeClicked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
