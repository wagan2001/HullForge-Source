<UserControl x:Class="FtdHullGenerator.UI.Components.InternalStructureEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:FtdHullGenerator.UI.Components"
             MinWidth="500" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Internal structure" />
            <TextBlock Margin="0,3,0,8" TextWrapping="Wrap" Style="{StaticResource MetricLabelStyle}"
                       Text="Check the walls or floors you want, then choose their material and clear spacing." />
            <ListBox x:Name="FamilyList" ItemsSource="{Binding Families}"
                     SelectedItem="{Binding SelectedFamily, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch"
                     AutomationProperties.Name="Internal plane families">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Content="{Binding DisplayName}" Margin="4,5"
                                  AutomationProperties.Name="{Binding DisplayName}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Style="{StaticResource RecessStyle}" Padding="8" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Resolved output" />
                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                               Text="{Binding SelectedFamily.RealizedSummary}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Column="2" DataContext="{Binding SelectedFamily}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="{Binding DisplayName}" />
                <Grid Margin="0,8,0,0" IsEnabled="{Binding Enabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Material" />
                        <ComboBox ItemsSource="{Binding MaterialChoices}" SelectedValuePath="Value"
                                  SelectedValue="{Binding Material, Mode=TwoWay}"
                                  AutomationProperties.Name="Internal structure material" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Clear spacing (m)" />
                        <ComboBox ItemsSource="{Binding ClearGapChoices}" SelectedItem="{Binding ClearGap, Mode=TwoWay}"
                                  AutomationProperties.Name="Clear space between walls or floors in metres" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding LayoutSummary}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Style="{StaticResource MetricLabelStyle}" />
                <Button Content="Use automatic layout" Click="AutomaticLayoutClicked" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Visibility="{Binding HasCustomLayout, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="Replace saved custom settings with automatic layout" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,10,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource RecessStyle}" Padding="4">
                    <components:InternalStructureGuide Height="92" Family="{Binding SelectedFamily.Family}" View="Front" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource RecessStyle}" Padding="4">
                    <components:InternalStructureGuide Height="92" Family="{Binding SelectedFamily.Family}" View="Side" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,8,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock Text="{Binding SelectedFamilyGuide}" TextWrapping="Wrap"
                           Style="{StaticResource MetricLabelStyle}" />
                <Button Margin="0,6,0,0" HorizontalAlignment="Left" Click="InspectCutawayClicked"
                        Content="Inspect selected family in 3D cutaway"
                        AutomationProperties.Name="Inspect selected internal family in 3D cutaway" />
            </StackPanel>

            <Border Grid.Row="3" Style="{StaticResource RecessStyle}" Padding="8" Margin="0,8,0,0"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl ItemsSource="{Binding SelectedDiagnostics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
