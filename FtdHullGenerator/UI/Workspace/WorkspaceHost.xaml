<UserControl x:Class="FtdHullGenerator.UI.Workspace.WorkspaceHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:FtdHullGenerator.UI.Layout"
             MinHeight="150" MinWidth="420"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             PreviewKeyDown="HostPreviewKeyDown">
    <Border Style="{StaticResource PanelBoxStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource GroupHeaderStyle}" Padding="12,6">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource CompactButtonStyle}"
                            Content="{Binding HostActionLabel}" Click="ToggleHostClicked"
                            AutomationProperties.Name="Detach or re-dock workspace" />
                    <TextBlock DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                               Text="{Binding DraftStatus}" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="Workspace" Style="{StaticResource SectionHeadingStyle}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Margin="8,6,8,4"
                        Focusable="True" KeyboardNavigation.TabNavigation="Local"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="Arrangement" AutomationProperties.Name="Arrangement workspace tab">
                    <layout:ArrangementView Workspace="{Binding}" Margin="4" />
                </TabItem>
                <TabItem Header="Components" AutomationProperties.Name="Component workspace tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  CanContentScroll="False">
                        <TextBlock Margin="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Component editors share this workspace and its one project draft." />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Diagnostics" AutomationProperties.Name="Workspace diagnostics tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  CanContentScroll="False">
                        <TextBlock Margin="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Barbette placement diagnostics appear on the Arrangement tab. Internal-structure diagnostics appear on the Components tab while Experimental Features is on." />
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="{DynamicResource PanelHeaderBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CancelDraftButton" MinWidth="78" Content="Cancel" Click="CancelClicked"
                                IsEnabled="{Binding CanCancel}" AutomationProperties.Name="Cancel workspace draft" />
                        <Button x:Name="ApplyDraftButton" MinWidth="78" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}" Content="Apply" Click="ApplyClicked"
                                IsEnabled="{Binding CanApply}" AutomationProperties.Name="Apply workspace draft" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MetricLabelStyle}"
                               Text="Enter applies · Escape cancels · one Apply is one undo item" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
