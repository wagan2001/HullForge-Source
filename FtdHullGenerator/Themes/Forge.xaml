<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Forge: the standard Hull Forge palette. Key for key it answers Workbench.xaml, so the
        same control templates, the same geometry, and the same spacing dress either one —
        this is the bench after dark, not a second design language. What changes is the
        material: a deep graphite chassis, surfaces lifted a step so panels read as machined
        plates, and a warmer, richer signal band where the light bench uses flat blue.
        Instrument blue still marks what the user acts on; gold is reserved for the primary
        key, live readouts, and the horizon band.
    -->

    <!-- Chassis and surfaces -->
    <Color x:Key="ChassisColor">#12161C</Color>
    <Color x:Key="PanelColor">#1B212A</Color>
    <Color x:Key="PanelHeaderColor">#232B36</Color>
    <Color x:Key="DisplayColor">#141C2B</Color>
    <Color x:Key="SteelColor">#2E8FD6</Color>
    <Color x:Key="SkyColor">#63A9E0</Color>
    <Color x:Key="GoldColor">#E4AB4F</Color>
    <Color x:Key="AmberColor">#E4AB4F</Color>
    <Color x:Key="OrangeColor">#E97A33</Color>
    <Color x:Key="RedColor">#D4373E</Color>

    <SolidColorBrush x:Key="ChassisBrush" Color="{StaticResource ChassisColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="{StaticResource PanelHeaderColor}" />
    <SolidColorBrush x:Key="DisplayBrush" Color="{StaticResource DisplayColor}" />
    <SolidColorBrush x:Key="RecessBrush" Color="#161C24" />
    <SolidColorBrush x:Key="ControlBrush" Color="#131920" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#2A3341" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#39424F" />
    <SolidColorBrush x:Key="EdgeShadowBrush" Color="#0C1016" />
    <SolidColorBrush x:Key="EdgeHighlightBrush" Color="#4A5768" />
    <SolidColorBrush x:Key="SteelBrush" Color="{StaticResource SteelColor}" />
    <SolidColorBrush x:Key="SkyBrush" Color="{StaticResource SkyColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource SkyColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#1E3550" />

    <!-- Raised key face: the same fall-off as the standard bench, cut from darker stock. -->
    <LinearGradientBrush x:Key="KeyFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#323C4B" Offset="0" />
        <GradientStop Color="#262E3A" Offset="1" />
    </LinearGradientBrush>

    <!-- Hover and press wash over a control face. A dark chassis lightens. -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PressOverlayBrush" Color="#000000" />

    <!-- Type -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E9EFF6" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C0CBD9" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A2B4" />
    <SolidColorBrush x:Key="InkBrush" Color="#0E141C" />
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#F4F8FC" />
    <SolidColorBrush x:Key="KnobBrush" Color="#E9EFF6" />
    <!-- Type on the readout tiles. -->
    <SolidColorBrush x:Key="DisplayTextBrush" Color="#F3EFE6" />
    <SolidColorBrush x:Key="DisplayLabelBrush" Color="#9DAABC" />

    <!-- Signal band -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F2BC64" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="#4A3B26" />
    <SolidColorBrush x:Key="ReadoutBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="#7FC9A2" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource OrangeColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E8606A" />

    <!-- Primary key: the gold-to-orange sweep. -->
    <SolidColorBrush x:Key="PrimaryKeyBorderBrush" Color="#C08A38" />
    <SolidColorBrush x:Key="PrimaryKeyBorderPressedBrush" Color="#A6702C" />

    <LinearGradientBrush x:Key="SunriseKeyBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0BA5C" Offset="0" />
        <GradientStop Color="{StaticResource GoldColor}" Offset="0.35" />
        <GradientStop Color="{StaticResource OrangeColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SunriseKeyPressedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C9923F" Offset="0" />
        <GradientStop Color="#C7642A" Offset="0.7" />
        <GradientStop Color="{StaticResource RedColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SunriseBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource GoldColor}" Offset="0" />
        <GradientStop Color="{StaticResource OrangeColor}" Offset="0.55" />
        <GradientStop Color="{StaticResource RedColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SunriseVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GoldColor}" Offset="0" />
        <GradientStop Color="{StaticResource OrangeColor}" Offset="0.5" />
        <GradientStop Color="{StaticResource RedColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- ==================== Lattice viewport ==================== -->
    <SolidColorBrush x:Key="ViewportBackgroundBrush" Color="#0F1B33" />

    <DrawingBrush x:Key="MinorGridBrush" TileMode="Tile"
                  Viewport="0,0,24,24" ViewportUnits="Absolute"
                  Viewbox="0,0,24,24" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="24,0" />
                        <LineGeometry StartPoint="0,0" EndPoint="0,24" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Thickness="1" Brush="#14FFFFFF" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="MajorGridBrush" TileMode="Tile"
                  Viewport="0,0,120,120" ViewportUnits="Absolute"
                  Viewbox="0,0,120,120" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="120,0" />
                        <LineGeometry StartPoint="0,0" EndPoint="0,120" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Thickness="1" Brush="#2A6D8DBF" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
